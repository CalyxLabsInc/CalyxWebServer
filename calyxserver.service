[Unit]
Description=Calyx Web Server
Documentation=file:///var/calyxserver/configuration/config.calyx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/calyxserver --config /var/calyxserver/configuration/config.calyx
WorkingDirectory=/var/calyxserver

# Restart Calyx after unexpected failures.
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Graceful service shutdown and predictable process behavior.
KillSignal=SIGTERM
TimeoutStopSec=30s
PrivateTmp=true
NoNewPrivileges=true

# Filesystem and kernel hardening.
ProtectSystem=strict
ReadWritePaths=/var/calyxserver
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true

# Calyx only requires IPv4/IPv6 network sockets and local Unix sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Send server output to the systemd journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calyxserver

[Install]
WantedBy=multi-user.target
